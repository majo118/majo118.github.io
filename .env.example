# ============================================================
# Variables de entorno del frontend (React / Vite)
# ------------------------------------------------------------
# TODO valor con prefijo VITE_ es PÚBLICO (queda embebido en el bundle).
# NUNCA pongas aquí la URL de n8n ni ningún secreto real.
# ============================================================

# --- Supabase (URL pública + anon key: seguro exponerlas si RLS está bien) ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi....

# --- Endpoint del Edge Function que actúa de proxy a n8n ---
# Formato: https://<project-ref>.supabase.co/functions/v1/chat-proxy
VITE_CHAT_PROXY_URL=https://xxxxxxxx.supabase.co/functions/v1/chat-proxy

# --- Base path del sitio en GitHub Pages ---
# Para user site (usuario.github.io) dejar en "/"
# Para project site (usuario.github.io/lumina-chat/) usar "/lumina-chat/"
VITE_BASE_PATH=/
